# Copy to .env locally and replace every placeholder. Never commit a real .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=capstone_portfolio
PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Reverse-proxy hops in front of the API. Render/Vercel use one; leave at 1.
TRUST_PROXY=1

# Optional overrides for `npm run seed` (defaults are documented in scripts/seed.js).
# SEED_ADMIN_USERNAME=zonghan
# SEED_ADMIN_EMAIL=admin@zonghan.dev
# SEED_ADMIN_PASSWORD=Capstone@2026
# SEED_RESET_PASSWORD=false
# SEED_PORTFOLIO_URL=
